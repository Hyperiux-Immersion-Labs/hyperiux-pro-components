{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vault-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "hyperiux-vault",
        "run",
        "dev"
      ],
      "port": 3333,
      "autoPort": true
    }
  ]
}
