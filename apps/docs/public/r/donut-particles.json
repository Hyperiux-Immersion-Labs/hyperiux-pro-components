{
  "name": "donut-particles",
  "type": "registry:component",
  "title": "Donut Particles",
  "description": "Interactive 3D donut particle field built with React Three Fiber. Includes cursor-driven flow, inertial motion, and a fullscreen canvas wrapper.",
  "dependencies": [
    "three",
    "@react-three/fiber"
  ],
  "registryDependencies": [],
  "exportName": "DonutParticles",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "donutPosition",
      "type": "array",
      "default": [
        0,
        0,
        0
      ],
      "description": "XYZ position of the particle donut."
    },
    {
      "name": "donutScale",
      "type": "number",
      "default": 3.5,
      "description": "Scale applied to the particle donut."
    },
    {
      "name": "donutRotation",
      "type": "array",
      "default": [
        -1.0471975512,
        0.7853981634,
        0
      ],
      "description": "XYZ rotation of the particle donut in radians."
    },
    {
      "name": "cameraPosition",
      "type": "array",
      "default": [
        2,
        4,
        6
      ],
      "description": "XYZ camera position for the WebGL scene."
    },
    {
      "name": "cameraFov",
      "type": "number",
      "default": 50,
      "description": "Camera field of view."
    },
    {
      "name": "dpr",
      "type": "array",
      "default": [
        1,
        2
      ],
      "description": "Device pixel ratio range used by the canvas."
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "donutPosition",
        "label": "Donut Position",
        "type": "json",
        "group": "layout"
      },
      {
        "name": "donutScale",
        "label": "Donut Scale",
        "type": "range",
        "group": "layout",
        "min": 1,
        "max": 7,
        "step": 0.1
      },
      {
        "name": "donutRotation",
        "label": "Donut Rotation",
        "type": "json",
        "group": "motion"
      },
      {
        "name": "cameraPosition",
        "label": "Camera Position",
        "type": "json",
        "group": "layout"
      },
      {
        "name": "cameraFov",
        "label": "Camera FOV",
        "type": "range",
        "group": "layout",
        "min": 20,
        "max": 90,
        "step": 1
      },
      {
        "name": "dpr",
        "label": "DPR",
        "type": "json",
        "group": "motion"
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/donut-particles/index.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/donut-particles/createSuspendedRaf.js"
    }
  ]
}