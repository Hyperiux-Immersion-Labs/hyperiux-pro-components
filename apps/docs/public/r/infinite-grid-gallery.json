{
  "name": "infinite-grid-gallery",
  "type": "registry:component",
  "title": "Infinite Grid Gallery",
  "description": "Infinite scrollable grid gallery with expandable overlay, thumbnails rail, and smooth open/close transitions.",
  "dependencies": [],
  "registryDependencies": [],
  "exportName": "InfiniteGridGallery",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "images",
      "type": "array",
      "default": [],
      "description": "Images rendered in the infinite grid.",
      "suggested": true
    },
    {
      "name": "columns",
      "type": "number",
      "default": 4,
      "description": "Desktop grid column count.",
      "suggested": true
    },
    {
      "name": "gap",
      "type": "number",
      "default": 44,
      "description": "Spacing between grid images.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Grid movement speed.",
      "suggested": true
    },
    {
      "name": "imageScale",
      "type": "number",
      "default": 1,
      "description": "Scale applied to gallery images.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "columns",
        "label": "Columns",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 1,
        "max": 8,
        "step": 1
      },
      {
        "name": "gap",
        "label": "Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0.05,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "imageScale",
        "label": "Image Scale",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0.5,
        "max": 2,
        "step": 0.05
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/infinite-grid-gallery/index.jsx"
    },
    {
      "path": "InfiniteGrid.jsx",
      "type": "registry:component",
      "target": "src/components/effects/infinite-grid-gallery/InfiniteGrid.jsx"
    },
    {
      "path": "util.js",
      "type": "registry:component",
      "target": "src/components/effects/infinite-grid-gallery/util.js"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/infinite-grid-gallery/createSuspendedRaf.js"
    }
  ]
}