{
  "name": "testimonial-swiper",
  "type": "registry:component",
  "title": "Testimonial Swiper",
  "description": "Editorial testimonial slider with split-text quote transitions and directional controls",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "exportName": "TestimonialSwiper",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.2.2",
  "changelog": [
    {
      "version": "1.2.2",
      "date": "2026-07-30",
      "summary": "Added top padding so the testimonial count and navigation sit below the demo header, and added an imageSize prop for testimonial images.",
      "breaking": false
    },
    {
      "version": "1.2.1",
      "date": "2026-07-30",
      "summary": "Removed the testimonials content prop from the public/remixer API and wired bgColor, accentColor, autoplay, autoplayDelay, and showNavigation into the testimonial slider.",
      "breaking": false
    },
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added testimonials and bgColor as public props with a working remixer panel. The originally suggested props (autoplay, autoplayDelay, accentColor, showNavigation) didn't match this component's real API, so they were replaced with the props TestimonialComp actually accepts.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Under reduced motion, use opacity fade instead of SplitText slides",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "bgColor",
      "type": "color",
      "default": "#edeae2",
      "description": "Background color behind the testimonial content.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "accentColor",
      "type": "color",
      "default": "#ff6b00",
      "description": "Accent color for the count, quote mark, and navigation controls.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "default": true,
      "description": "Automatically advances testimonials.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "autoplayDelay",
      "type": "number",
      "default": 4500,
      "description": "Delay between testimonial changes in milliseconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 1000,
        "max": 9000,
        "step": 250
      }
    },
    {
      "name": "showNavigation",
      "type": "boolean",
      "default": true,
      "description": "Shows previous/next controls.",
      "remixer": {
        "control": "checkbox",
        "group": "controls",
        "groupTitle": "Controls"
      }
    },
    {
      "name": "imageSize",
      "type": "number",
      "default": 1,
      "description": "Scale multiplier for the testimonial images.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0.6,
        "max": 1.8,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/testimonial-swiper/index.jsx"
    },
    {
      "path": "NavigationButtons.jsx",
      "type": "registry:component",
      "target": "src/components/effects/testimonial-swiper/NavigationButtons.jsx"
    },
    {
      "path": "TestimonialComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/testimonial-swiper/TestimonialComp.jsx"
    }
  ]
}