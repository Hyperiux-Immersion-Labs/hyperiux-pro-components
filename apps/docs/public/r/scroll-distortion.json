{
  "name": "scroll-distortion",
  "type": "registry:component",
  "title": "Scroll Distortion",
  "description": "Scroll-synced WebGL image transition with displacement distortion and fullscreen typography",
  "dependencies": [
    "gsap",
    "three"
  ],
  "registryDependencies": [],
  "exportName": "ScrollDistortion",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: the WebGL image transition drops its displacement/RGB-shift warp for a plain crossfade, and the text transition fades instead of sliding",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "shaderConfig",
      "type": "object",
      "default": {
        "strength": 0.8,
        "rgbShift": 0.05,
        "scale": 0.15,
        "transitionDuration": 0.8,
        "transitionEase": "power3.inOut"
      },
      "description": "Shader strength, RGB shift, scale, and transition settings.",
      "remixer": {
        "control": "json",
        "group": "shader",
        "groupTitle": "Shader"
      }
    },
    {
      "name": "displacementSrc",
      "type": "string",
      "default": "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/distortion-noise.jpg",
      "description": "Displacement texture source.",
      "remixer": {
        "control": "text",
        "group": "media",
        "groupTitle": "Media"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "shader",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/scroll-distortion/index.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/scroll-distortion/createSuspendedRaf.js"
    }
  ]
}