{
  "name": "parallax-gallery",
  "type": "registry:component",
  "title": "Parallax Gallery",
  "description": "Pinned frame gallery with snapping slides and mirrored thumbnail rails",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "exportName": "ParallaxGallery",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.1",
  "changelog": [
    {
      "version": "1.1.1",
      "date": "2026-07-23",
      "summary": "Fixed crash in scroll-snap onStart: lenis.stop() now uses optional chaining so consumers without a Lenis provider no longer throw a TypeError on every snap",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: off-center item rotation and scale are reduced to 25% strength instead of full parallax",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "images",
      "type": "array",
      "default": [],
      "description": "Gallery images used in the parallax layout.",
      "suggested": true
    },
    {
      "name": "columns",
      "type": "number",
      "default": 3,
      "description": "Number of gallery columns.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Parallax movement speed.",
      "suggested": true
    },
    {
      "name": "gap",
      "type": "number",
      "default": 24,
      "description": "Spacing between gallery items.",
      "suggested": true
    },
    {
      "name": "scaleOnScroll",
      "type": "boolean",
      "default": false,
      "description": "Enables image scaling while scrolling.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "images",
        "label": "Images",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "columns",
        "label": "Columns",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "gap",
        "label": "Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "scaleOnScroll",
        "label": "Scale On Scroll",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/parallax-gallery/index.jsx"
    },
    {
      "path": "ParallaxGallery.jsx",
      "type": "registry:component",
      "target": "src/components/effects/parallax-gallery/ParallaxGallery.jsx"
    }
  ]
}
