{
  "name": "grid-scale",
  "type": "registry:component",
  "title": "Grid Scale",
  "description": "Scroll-driven animation where a centered clip-path panel expands to fullscreen while corner boxes fly in, grid lines dissolve, and floating keyword pills converge to the center.",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "GridScale",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.1",
  "changelog": [
    {
      "version": "1.1.1",
      "date": "2026-07-23",
      "summary": "Fixed malformed ScrollTrigger start value ('% top' -> 'top top') on the floating-words timeline; it previously parsed to NaN and anchored the animation to absolute page top instead of the section",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: box/grid-line/clip-path tweens lose their eased curve and floating words fade in place instead of converging to center",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "items",
      "type": "array",
      "default": [],
      "description": "Grid items affected by the scale animation.",
      "suggested": true
    },
    {
      "name": "columns",
      "type": "number",
      "default": 4,
      "description": "Number of grid columns on desktop.",
      "suggested": true
    },
    {
      "name": "scaleAmount",
      "type": "number",
      "default": 1.18,
      "description": "Hover or scroll scale amount.",
      "suggested": true
    },
    {
      "name": "gap",
      "type": "number",
      "default": 20,
      "description": "Spacing between grid items.",
      "suggested": true
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.4,
      "description": "Scale animation duration.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "items",
        "label": "Items",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "columns",
        "label": "Columns",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 12,
        "step": 0.1
      },
      {
        "name": "scaleAmount",
        "label": "Scale Amount",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3.54,
        "step": 0.05
      },
      {
        "name": "gap",
        "label": "Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "duration",
        "label": "Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/grid-scale/index.jsx"
    }
  ]
}
