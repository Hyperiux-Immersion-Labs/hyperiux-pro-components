{
  "name": "grid-tunnel",
  "type": "registry:component",
  "title": "Grid Tunnel",
  "description": "Infinite 3D image tunnel built with React Three Fiber, procedural wireframe chunks, and inertial wheel-driven camera motion.",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "three"
  ],
  "registryDependencies": [],
  "exportName": "GridTunnel",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-24",
      "summary": "Added a prefers-reduced-motion notice, and hardened camera-frame timing so a long tab-hidden pause no longer displaces the camera (and by extension the recycled tunnel chunks) on resume.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "gridSize",
      "type": "number",
      "default": 24,
      "description": "Density of the tunnel grid.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Tunnel travel speed.",
      "suggested": true
    },
    {
      "name": "depth",
      "type": "number",
      "default": 1000,
      "description": "Depth of the tunnel scene.",
      "suggested": true
    },
    {
      "name": "lineColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Grid line color.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Tunnel background color.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "gridSize",
        "label": "Grid Size",
        "type": "range",
        "group": "content",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "depth",
        "label": "Depth",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3000,
        "step": 0.1
      },
      {
        "name": "lineColor",
        "label": "Line Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/grid-tunnel/index.jsx"
    },
    {
      "path": "GridTunnelComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/grid-tunnel/GridTunnelComp.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/grid-tunnel/createSuspendedRaf.js"
    }
  ]
}
