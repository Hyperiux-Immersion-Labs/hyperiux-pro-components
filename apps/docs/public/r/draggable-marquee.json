{
  "name": "draggable-marquee",
  "type": "registry:component",
  "title": "Draggable Marquee",
  "description": "Infinite horizontal marquee with drag interaction and momentum physics",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "DraggableMarquee",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.1",
  "changelog": [
    {
      "version": "1.1.1",
      "date": "2026-07-23",
      "summary": "Offscreen pause now detaches only the marquee's own ticker callback instead of sleeping the global gsap.ticker, which froze every other GSAP animation on the page",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: auto-scroll and post-release throw momentum are disabled, drag remains fully interactive",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "items",
      "type": "array",
      "default": [],
      "description": "Items rendered inside the marquee.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Autoplay movement speed.",
      "suggested": true
    },
    {
      "name": "dragSensitivity",
      "type": "number",
      "default": 0.12,
      "description": "How strongly drag input scrubs the marquee.",
      "suggested": true
    },
    {
      "name": "gap",
      "type": "number",
      "default": 32,
      "description": "Spacing between marquee items.",
      "suggested": true
    },
    {
      "name": "pauseOnHover",
      "type": "boolean",
      "default": false,
      "description": "Pauses autoplay while hovered.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "items",
        "label": "Items",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "dragSensitivity",
        "label": "Drag Sensitivity",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "gap",
        "label": "Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 128,
        "step": 1
      },
      {
        "name": "pauseOnHover",
        "label": "Pause On Hover",
        "type": "toggle",
        "group": "motion",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/draggable-marquee/index.jsx"
    },
    {
      "path": "DraggableMarqueeComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/draggable-marquee/DraggableMarqueeComp.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/draggable-marquee/createSuspendedRaf.js"
    }
  ]
}