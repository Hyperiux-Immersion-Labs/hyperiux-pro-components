{
  "name": "infinite-carousel",
  "type": "registry:component",
  "title": "Infinite Carousel",
  "description": "Infinitely looping horizontal carousel with GSAP Draggable + inertia, plus mobile-friendly wrap/swiper fallbacks.",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "exportName": "InfiniteCarousel",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added cards, draggable, showNav, and mobileBreakpoint as public props instead of hardcoding them in the wrapper",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: drag inertia, nav-button tweens, and mobile scroll-snap are shortened or disabled when the user has reduced motion enabled",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "draggable",
      "type": "boolean",
      "default": true,
      "description": "Allows dragging the carousel with pointer/touch input.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "gap",
      "type": "number",
      "description": "Spacing between carousel items.",
      "default": 32,
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 1200,
        "step": 1
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "behavior",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/infinite-carousel/index.jsx"
    },
    {
      "path": "InfiniteCarouselComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/infinite-carousel/InfiniteCarouselComp.jsx"
    }
  ]
}