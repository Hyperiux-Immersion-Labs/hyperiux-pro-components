{
  "name": "ribbon-drift",
  "type": "registry:component",
  "title": "Ribbon Drift",
  "description": "Scroll-driven ribbon gallery where image strips drift horizontally at alternating speeds, revealing project names with GSAP SplitText on scroll.",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "exportName": "RibbonDrift",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.3.0",
  "changelog": [
    {
      "version": "1.4.0",
      "date": "2026-07-28",
      "summary": "Added images and projectNames as public props with a working remixer panel. The originally suggested props (ribbons, driftSpeed, amplitude, ribbonColor, pauseOnHover) didn't match this component's real API, so they were replaced with the props RibbonDriftComp actually accepts.",
      "breaking": false
    },
    {
      "version": "1.3.0",
      "date": "2026-07-24",
      "summary": "Removed the reduced-motion animation branching entirely - the scroll-driven reveal, hover splits, and strip transitions now always run identically to the default; only the reduced-motion notice remains conditional.",
      "breaking": false
    },
    {
      "version": "1.2.0",
      "date": "2026-07-24",
      "summary": "Synced the docs-mirror RibbonDriftComp with the registry copy's full prefers-reduced-motion support (static layout, X-only strip exits, fade-based intro/hover transitions) - the mirror was missing all of it.",
      "breaking": false
    },
    {
      "version": "1.1.1",
      "date": "2026-07-23",
      "summary": "Restored the mobile full-height wrapper rule (max-md:h-full) that was lost to a max-snm typo; docs copy typo corrected to max-sm.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added reduced-motion notice",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "images",
      "type": "array",
      "default": [
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-01.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-02.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-03.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-05.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-06.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-07.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-08.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-09.jpg",
        "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-10.jpg"
      ],
      "description": "Image pool used to build the drifting ribbon strips.",
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "projectNames",
      "type": "array",
      "default": [
        "Nebula Drift",
        "Velvet Orbit",
        "Prism Bloom",
        "Midnight Aurora",
        "Chromatic Tide",
        "Ion Garden",
        "Lunar Gradient",
        "Violet Haze",
        "Echo Spectrum",
        "Noir Fluence"
      ],
      "description": "Project name labels cycled across the ribbon cards.",
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "ribbons",
      "type": "array",
      "description": "Ribbon labels or image strips rendered by the effect.",
      "default": [],
      "remixer": {
        "control": "json",
        "group": "controls",
        "groupTitle": "Controls"
      }
    },
    {
      "name": "driftSpeed",
      "type": "number",
      "description": "Speed of the ribbon drift.",
      "default": 1,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "amplitude",
      "type": "number",
      "description": "Vertical drift amplitude.",
      "default": 36,
      "remixer": {
        "control": "range",
        "group": "controls",
        "groupTitle": "Controls",
        "min": 0,
        "max": 108,
        "step": 1
      }
    },
    {
      "name": "ribbonColor",
      "type": "color",
      "description": "Primary ribbon color.",
      "default": "#ff6b00",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "pauseOnHover",
      "type": "boolean",
      "description": "Pauses ribbon motion on hover.",
      "default": false,
      "remixer": {
        "control": "checkbox",
        "group": "controls",
        "groupTitle": "Controls"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/ribbon-drift/index.jsx"
    },
    {
      "path": "RibbonDriftComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/ribbon-drift/RibbonDriftComp.jsx"
    }
  ]
}