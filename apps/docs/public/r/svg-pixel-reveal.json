{
  "name": "svg-pixel-reveal",
  "type": "registry:component",
  "title": "SVG Pixel Reveal",
  "description": "Scroll-driven image that transitions from pixelated to crisp using an SVG filter and GSAP ScrollTrigger",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "SvgPixelReveal",
  "exportKind": "named",
  "tier": "pro",
  "version": "1.0.0",
  "changelog": [],
  "props": [
    {
      "name": "initialPixelSize",
      "type": "number",
      "default": 22,
      "description": "Starting SVG pixel filter size.",
      "remixer": {
        "control": "range",
        "group": "filter",
        "groupTitle": "Filter",
        "min": 2,
        "max": 80,
        "step": 1
      }
    },
    {
      "name": "finalPixelSize",
      "type": "number",
      "default": 1,
      "description": "Final SVG pixel filter size.",
      "remixer": {
        "control": "range",
        "group": "filter",
        "groupTitle": "Filter",
        "min": 1,
        "max": 20,
        "step": 1
      }
    },
    {
      "name": "crossLayers",
      "type": "boolean",
      "default": true,
      "description": "Enables cross-layer pixel merge detail.",
      "remixer": {
        "control": "checkbox",
        "group": "filter",
        "groupTitle": "Filter"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "filter",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-pixel-reveal/index.jsx"
    },
    {
      "path": "PixelatedScgFilter.jsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-pixel-reveal/PixelatedScgFilter.jsx"
    }
  ]
}