{
  "name": "circle-text-reveal",
  "type": "registry:component",
  "title": "Circle Text Reveal",
  "description": "Cursor-following circle mask that reveals hidden text underneath on hover",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [],
  "exportName": "CircleTextReveal",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion pointer reveal.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "Text",
      "type": "string",
      "default": "Some ideas only bloom when you move toward them.",
      "description": "Main visible text.",
      "remixer": {
        "control": "textarea",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "revealText",
      "type": "string",
      "default": "The hidden layer has been waiting for your cursor.",
      "description": "Text revealed inside the cursor circle.",
      "remixer": {
        "control": "textarea",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#111111",
      "description": "Base text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "circleColorBg",
      "type": "string",
      "default": "#ff5f00",
      "description": "Reveal circle background color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "RevealedTextColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Revealed text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/circle-text-reveal/index.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/circle-text-reveal/createSuspendedRaf.js"
    }
  ]
}