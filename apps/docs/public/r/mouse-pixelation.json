{
  "name": "mouse-pixelation",
  "type": "registry:component",
  "title": "Mouse Pixelation",
  "description": "Three R3F WebGL mouse-reactive pixelation effects behind a version-switcher header. V1: GLSL pixel-circle shader with animated orbiting circles and GSAP scroll pin. V2: image texture with velocity-driven block displacement. V3: extruded pixel trail grid paired with a deforming bloom-lit cube that auto-cycles neon colors.",
  "dependencies": [
    "three",
    "@react-three/fiber",
    "@react-three/postprocessing",
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "MousePixelation",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added reduced-motion notice",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "variant",
      "type": "string",
      "default": "pixel-shift",
      "description": "Selects the active pixelation version."
    },
    {
      "name": "imageUrl",
      "type": "string",
      "default": "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/h-02.jpg",
      "description": "Image texture used by supported pixelation variants."
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "variant",
        "label": "Variant",
        "type": "select",
        "group": "content",
        "options": [
          {
            "label": "Pixel Circle",
            "value": "pixel-circle"
          },
          {
            "label": "Pixel Shift",
            "value": "pixel-shift"
          },
          {
            "label": "Enhanced Pixel Cube",
            "value": "enhanced-pixel-cube"
          }
        ]
      },
      {
        "name": "imageUrl",
        "label": "Image URL",
        "type": "text",
        "group": "media",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/mouse-pixelation/index.jsx"
    },
    {
      "path": "EnhancedPixelCube.jsx",
      "type": "registry:component",
      "target": "src/components/effects/mouse-pixelation/EnhancedPixelCube.jsx"
    },
    {
      "path": "PixelCircle.jsx",
      "type": "registry:component",
      "target": "src/components/effects/mouse-pixelation/PixelCircle.jsx"
    },
    {
      "path": "PixelShift.jsx",
      "type": "registry:component",
      "target": "src/components/effects/mouse-pixelation/PixelShift.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/mouse-pixelation/createSuspendedRaf.js"
    }
  ]
}