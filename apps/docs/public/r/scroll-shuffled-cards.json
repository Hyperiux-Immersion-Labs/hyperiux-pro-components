{
  "name": "scroll-shuffled-cards",
  "type": "registry:component",
  "title": "Scroll Shuffled Cards",
  "description": "Pinned scroll section that drifts a shuffled stack of editorial cards across the viewport",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "ScrollShuffledCards",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: cards stay at their resting position with 0 rotation instead of shuffling; the container's overall scroll slide is unaffected",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "cards",
      "type": "array",
      "default": [],
      "description": "Cards shuffled by scroll progress.",
      "suggested": true
    },
    {
      "name": "shuffleAmount",
      "type": "number",
      "default": 80,
      "description": "Maximum movement distance during shuffle.",
      "suggested": true
    },
    {
      "name": "rotationAmount",
      "type": "number",
      "default": 12,
      "description": "Maximum rotation during shuffle.",
      "suggested": true
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.08,
      "description": "Delay between card movements.",
      "suggested": true
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links shuffle progress to scroll.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "cards",
        "label": "Cards",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "shuffleAmount",
        "label": "Shuffle Amount",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 240,
        "step": 0.1
      },
      {
        "name": "rotationAmount",
        "label": "Rotation Amount",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 36,
        "step": 0.1
      },
      {
        "name": "stagger",
        "label": "Stagger",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "scrub",
        "label": "Scrub",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/scroll-shuffled-cards/index.jsx"
    },
    {
      "path": "card.jsx",
      "type": "registry:component",
      "target": "src/components/effects/scroll-shuffled-cards/card.jsx"
    },
    {
      "path": "ScrollShuffledCardsComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/scroll-shuffled-cards/ScrollShuffledCardsComp.jsx"
    }
  ]
}