{
  "name": "information-drawer",
  "type": "registry:component",
  "title": "Information Drawer",
  "description": "Team profile grid with an animated information drawer and editable panel styling",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "exportName": "InformationDrawer",
  "exportKind": "default",
  "importPath": "@/components/effects/information-drawer",
  "tier": "free",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-11-02",
      "summary": "Registry sidebarWidth default corrected to 70 (70%) to match the component.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-08-21",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 0.65,
      "description": "Drawer panel and overlay slide duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.1,
        "max": 2,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "contentDuration",
      "type": "number",
      "default": 0.25,
      "description": "Duration in seconds of the content fade, staged after the panel opens and before it closes.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.05,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "contentDelay",
      "type": "number",
      "default": 0.4,
      "description": "Delay in seconds before the staged content fades in, measured from when the drawer starts opening.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "ease",
      "type": "string",
      "default": "power2.inOut",
      "description": "GSAP easing used by the drawer panel and overlay.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0,
      "description": "Delay before the drawer animation starts, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "backgroundColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Background color of the drawer panel.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#111111",
      "description": "Text and icon color inside the drawer panel.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "sidebarWidth",
      "type": "number | string",
      "default": 70,
      "description": "Desktop drawer width. Numbers are applied as a percentage (70 renders as \"70%\").",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 40,
        "max": 90,
        "step": 1
      }
    },
    {
      "name": "overlayOpacity",
      "type": "number",
      "default": 0.2,
      "description": "Backdrop opacity while the drawer is open.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 0.8,
        "step": 0.01
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/information-drawer/index.tsx",
      "content": "// Sign in to install this effect: npx hyperiux@latest login, then npx hyperiux@latest add <effect>\n"
    }
  ]
}