{
  "name": "glitchy-text",
  "type": "registry:component",
  "title": "Glitchy Text",
  "description": "GSAP SplitText effect that stagger-animates four overlapping char layers — two white and two yellow — out and in at slightly different delays, creating a chromatic glitch swap. Plays on mount and replays on button click.",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "GlitchyText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion glitch playback.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "Engineering meets artistry",
      "description": "Text animated by the glitch reveal.",
      "remixer": {
        "control": "text",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "runOnScroll",
      "type": "boolean",
      "default": false,
      "description": "Runs animation from scroll instead of manual replay.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "once",
      "type": "boolean",
      "default": true,
      "description": "Runs scroll trigger once.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "initialDelay",
      "type": "number",
      "default": 2.5,
      "description": "Initial animation delay.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "name": "replayDelay",
      "type": "number",
      "default": 0.2,
      "description": "Replay animation delay.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/glitchy-text/index.jsx"
    }
  ]
}