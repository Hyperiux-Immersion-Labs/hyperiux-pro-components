{
  "name": "svg-brush-transition",
  "type": "registry:component",
  "title": "SVG Brush Transition",
  "description": "Brush-stroke navigation transition that draws a large SVG path across the viewport",
  "dependencies": [
    "gsap",
    "next-transition-router"
  ],
  "registryDependencies": [],
  "exportName": "SVGBrushTransition",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion route fallback with short opacity fades.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "config",
      "type": "object",
      "default": {
        "enableBlur": false,
        "strokeColor": "#82A0FF",
        "strokeWidth": 2,
        "duration": 1.5
      },
      "description": "Brush stroke color, width, blur, and duration.",
      "remixer": {
        "control": "json",
        "group": "config",
        "groupTitle": "Config"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "config",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-brush-transition/index.jsx"
    }
  ]
}