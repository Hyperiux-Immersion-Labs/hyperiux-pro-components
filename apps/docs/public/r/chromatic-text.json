{
  "name": "chromatic-text",
  "type": "registry:component",
  "title": "Chromatic Text",
  "description": "Three-layer scroll-reactive chromatic text with white, red, and blue depth layers.",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "ChromaticText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-08-14",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "textColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Color of the front/base text layer.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "redColor",
      "type": "string",
      "default": "#ff0000",
      "description": "Color of the red chromatic depth layer.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "blueColor",
      "type": "string",
      "default": "#0047ff",
      "description": "Color of the blue chromatic depth layer.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "fontSize",
      "type": "number",
      "default": 10,
      "description": "Font size in vw units shared by every text layer.",
      "remixer": {
        "control": "range",
        "group": "type",
        "groupTitle": "Type",
        "min": 4,
        "max": 18,
        "step": 0.25
      }
    },
    {
      "name": "fontWeight",
      "type": "number",
      "default": 800,
      "description": "Font weight shared by every text layer.",
      "remixer": {
        "control": "range",
        "group": "type",
        "groupTitle": "Type",
        "min": 100,
        "max": 900,
        "step": 100
      }
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#111111",
      "description": "Background color for the scroll section.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "colors",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/chromatic-text/index.tsx"
    }
  ]
}