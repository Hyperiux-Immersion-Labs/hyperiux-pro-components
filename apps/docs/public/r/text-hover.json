{
  "name": "text-hover",
  "type": "registry:component",
  "title": "Text Hover",
  "description": "Expandable text list with hover/click to reveal descriptions and animated corner brackets",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "TextHover",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion hover interactions.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "items",
      "type": "array",
      "default": [],
      "description": "Text rows or industry items revealed on hover.",
      "suggested": true
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Base text color.",
      "suggested": true
    },
    {
      "name": "hoverColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Text color while hovered.",
      "suggested": true
    },
    {
      "name": "expandAmount",
      "type": "number",
      "default": 1.18,
      "description": "Scale or expansion amount on hover.",
      "suggested": true
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.35,
      "description": "Hover animation duration.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "items",
        "label": "Items",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "textColor",
        "label": "Text Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "hoverColor",
        "label": "Hover Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "expandAmount",
        "label": "Expand Amount",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "duration",
        "label": "Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/text-hover/index.jsx"
    },
    {
      "path": "TextHoverComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/text-hover/TextHoverComp.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/text-hover/createSuspendedRaf.js"
    }
  ]
}
