{
  "name": "spotlight-text",
  "type": "registry:component",
  "title": "Spotlight Text",
  "description": "Mouse-tracked spotlight that reveals bright text through a radial gradient mask over dimmed text. Disabled on mobile.",
  "dependencies": [],
  "registryDependencies": [],
  "exportName": "SpotlightText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion spotlight tracking.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "Hyperiux Vault is where design meets precision - a thoughtfully crafted component library built for developers who care about performance, aesthetics, and experience. Every interaction is intentional, every animation feels alive, and every component is designed to elevate modern interfaces beyond the ordinary.",
      "description": "Text shown under the spotlight.",
      "remixer": {
        "control": "textarea",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "size",
      "type": "string",
      "default": "text-3xl",
      "description": "Text size class.",
      "remixer": {
        "control": "text",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "align",
      "type": "string",
      "default": "center",
      "description": "Text alignment.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/spotlight-text/index.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/spotlight-text/createSuspendedRaf.js"
    }
  ]
