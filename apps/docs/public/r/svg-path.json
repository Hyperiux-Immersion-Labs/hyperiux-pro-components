{
  "name": "svg-path",
  "type": "registry:component",
  "title": "Marquee on SVG Path",
  "description": "Animate any content along a custom SVG path. Supports scroll velocity, drag interaction, hover slowdown, and responsive scaling.",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [],
  "exportName": "SVGPath",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-24",
      "summary": "Ported prefers-reduced-motion support from the docs copy: static scroll-tracked positioning instead of spring/lerp smoothing, and dragging disabled while reduced motion is active.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-23",
      "summary": "Marquee now suspends its per-frame work while offscreen or in a hidden tab via the shared createSuspendedRaf visibility gate",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "path",
      "type": "string",
      "default": "defaultPath",
      "description": "SVG path used by the marquee.",
      "suggested": true
    },
    {
      "name": "viewBox",
      "type": "string",
      "default": "\"0 0 1200 600\"",
      "description": "SVG viewBox for the path.",
      "suggested": true
    },
    {
      "name": "baseVelocity",
      "type": "number",
      "default": 8,
      "description": "Base movement speed along the path.",
      "suggested": true
    },
    {
      "name": "repeat",
      "type": "number",
      "default": 2,
      "description": "Number of times children repeat on the path.",
      "suggested": true
    },
    {
      "name": "showPath",
      "type": "boolean",
      "default": false,
      "description": "Shows the SVG guide path.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "path",
        "label": "Path",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "viewBox",
        "label": "View Box",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "baseVelocity",
        "label": "Base Velocity",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 24,
        "step": 0.1
      },
      {
        "name": "repeat",
        "label": "Repeat",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "showPath",
        "label": "Show Path",
        "type": "toggle",
        "group": "content",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-path/index.jsx"
    },
    {
      "path": "SVGPathComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-path/SVGPathComp.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/svg-path/createSuspendedRaf.js"
    }
  ]
}
