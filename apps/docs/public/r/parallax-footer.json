{
  "name": "parallax-footer",
  "type": "registry:component",
  "title": "Parallax Footer",
  "description": "Fixed footer that reveals with a parallax scrolling effect",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "exportName": "ParallaxFooter",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.0",
  "changelog": [],
  "props": [
    {
      "name": "height",
      "type": "string",
      "default": "\"100vh\"",
      "description": "Height of the parallax footer section.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Footer background color.",
      "suggested": true
    },
    {
      "name": "offset",
      "type": "number",
      "default": 120,
      "description": "Vertical reveal offset.",
      "suggested": true
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links footer reveal to scroll progress.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "height",
        "label": "Height",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "offset",
        "label": "Offset",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 360,
        "step": 0.1
      },
      {
        "name": "scrub",
        "label": "Scrub",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/parallax-footer/index.jsx"
    },
    {
      "path": "ParallaxFooter.jsx",
      "type": "registry:component",
      "target": "src/components/effects/parallax-footer/ParallaxFooter.jsx"
    }
  ]
}