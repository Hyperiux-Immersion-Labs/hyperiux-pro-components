      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added images as a public prop instead of hardcoding it in the wrapper",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: scroll-snap animations are skipped/shortened when the user has reduced motion enabled",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
