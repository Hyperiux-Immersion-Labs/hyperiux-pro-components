      }
    },
    {
      "name": "slides",
      "type": "array",
      "description": "Image or media slides rendered in the WebGL scene.",
      "default": [],
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "distortionStrength",
      "type": "number",
      "description": "Strength of the shader distortion during transitions.",
      "default": 0.35,
      "remixer": {
        "control": "range",
        "group": "controls",
        "groupTitle": "Controls",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "transitionDuration",
      "type": "number",
      "description": "WebGL slide transition duration.",
      "default": 0.9,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "backgroundColor",
      "type": "color",
      "description": "Canvas background color.",
      "default": "#000000",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "showControls",
      "type": "boolean",
      "description": "Shows slider navigation controls.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "controls",
        "groupTitle": "Controls"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
