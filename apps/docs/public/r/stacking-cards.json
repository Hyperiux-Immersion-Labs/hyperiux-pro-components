{
  "name": "stacking-cards",
  "type": "registry:component",
  "title": "Stacking Cards",
  "description": "Full-screen card sequence that stacks, tilts, and reveals the next scene on scroll",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "exportName": "StackingCards",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.2",
  "changelog": [
    {
      "version": "1.0.2",
      "date": "2026-07-22",
      "summary": "Fixed the outgoing card staying at full opacity behind the incoming one in reduced motion (only its tilt/scale/rotateX/image-zoom were skipped, not its opacity fade), which let it visibly bleed through above the current card. The opacity crossfade isn't spatial motion, so it now still runs in reduced motion.",
      "breaking": false
    },
    {
      "version": "1.0.1",
      "date": "2026-07-22",
      "summary": "Fixed the last card not reaching full screen on mobile - the sticky pin container and scroll-space height used 100vh (largest possible mobile viewport) while the card content itself already used 100svh, so the container could render taller than what's actually visible when the browser's address bar is showing. Both now use svh consistently.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-21",
      "summary": "Initial release with prefers-reduced-motion support for reduced scroll and card motion.",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "cards",
      "type": "array",
      "default": [],
      "description": "Cards rendered in the stacking scroll sequence.",
      "suggested": true
    },
    {
      "name": "offset",
      "type": "number",
      "default": 80,
      "description": "Vertical offset between stacked cards.",
      "suggested": true
    },
    {
      "name": "scaleStep",
      "type": "number",
      "default": 0.05,
      "description": "Scale reduction per stacked card.",
      "suggested": true
    },
    {
      "name": "stickyTop",
      "type": "number",
      "default": 96,
      "description": "Top offset for sticky card behavior.",
      "suggested": true
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links stacking progress to scroll.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "cards",
        "label": "Cards",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "offset",
        "label": "Offset",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 240,
        "step": 0.1
      },
      {
        "name": "scaleStep",
        "label": "Scale Step",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "stickyTop",
        "label": "Sticky Top",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 288,
        "step": 0.1
      },
      {
        "name": "scrub",
        "label": "Scrub",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/stacking-cards/index.jsx"
    },
    {
      "path": "StackingCardComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/stacking-cards/StackingCardComp.jsx"
    }
  ]
}
