{
  "name": "scramble-text",
  "type": "registry:component",
  "title": "Scramble Text",
  "description": "Hacker-style text scramble effect that reveals text character by character on scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "ScrambleText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion scramble playback.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "Every frame is deliberate.",
      "description": "Text revealed by the scramble effect.",
      "remixer": {
        "control": "text",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "speed",
      "type": "number",
      "default": 0.6,
      "description": "Scramble playback speed.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "charType",
      "type": "string",
      "default": "lowercase",
      "description": "Character set used while scrambling.",
      "remixer": {
        "control": "select",
        "group": "motion",
        "groupTitle": "Motion",
        "options": [
          {
            "value": "lowercase",
            "label": "Lowercase"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "mixed",
            "label": "Mixed"
          }
        ]
      }
    },
    {
      "name": "textSize",
      "type": "string",
      "default": "text-base",
      "description": "Text size class.",
      "remixer": {
        "control": "text",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "text-white",
      "description": "Text color class.",
      "remixer": {
        "control": "text",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "align",
      "type": "string",
      "default": "left",
      "description": "Text alignment.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/scramble-text/index.jsx"
    }
  ]
}