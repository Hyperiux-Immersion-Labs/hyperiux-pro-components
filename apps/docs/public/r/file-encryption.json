{
  "name": "file-encryption",
  "type": "registry:component",
  "title": "File Encryption",
  "description": "Auto-scrolling draggable card marquee with a WebGL laser beam that splits each card between its plain and ASCII/encrypted face, plus Canvas 2D particle scatter.",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "FileEncryption",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "fileName",
      "type": "string",
      "default": "\"vault.zip\"",
      "description": "Demo file name displayed by the interface.",
      "suggested": true
    },
    {
      "name": "progress",
      "type": "number",
      "default": 0,
      "description": "Initial encryption progress value.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Accent color for progress and status.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Animation speed for the encryption sequence.",
      "suggested": true
    },
    {
      "name": "showStatusText",
      "type": "boolean",
      "default": false,
      "description": "Shows status labels during the sequence.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "fileName",
        "label": "File Name",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "progress",
        "label": "Progress",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "showStatusText",
        "label": "Show Status Text",
        "type": "toggle",
        "group": "content",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/file-encryption/index.jsx"
    },
    {
      "path": "FileEncryptionComp.jsx",
      "type": "registry:component",
      "target": "src/components/effects/file-encryption/FileEncryptionComp.jsx"
    },
    {
      "path": "webgl-context-recovery.js",
      "type": "registry:component",
      "target": "src/components/effects/file-encryption/webgl-context-recovery.js"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/file-encryption/createSuspendedRaf.js"
    }
  ]
}
