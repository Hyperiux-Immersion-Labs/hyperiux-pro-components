      "description": "Text filled on scroll.",
      "remixer": {
        "control": "textarea",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#111111",
      "description": "Final text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "primaryColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Highlight color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "dimColor",
      "type": "string",
      "default": "#AAAAAA",
      "description": "Initial dimmed text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#F0EFE9",
      "description": "Section background color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "textSize",
      "type": "string",
      "default": "3vw",
      "description": "Desktop text size.",
      "remixer": {
        "control": "text",
        "group": "layout",
        "groupTitle": "Layout"
      }
    },
    {
      "name": "textWidth",
      "type": "string",
      "default": "60%",
      "description": "Desktop text width.",
      "remixer": {
        "control": "text",
        "group": "layout",
        "groupTitle": "Layout"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/text-fill-animation/index.jsx"
