{
  "name": "hero-banner-animated",
  "type": "registry:component",
  "title": "Hero Banner Animated",
  "description": "Immersive WebGL hero with a 3D room, interactive TV screen with pixelated video transition, mouse-tracked lighting, edge blur, and film grain post-processing.",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "@react-three/postprocessing",
    "postprocessing",
    "gsap",
    "three",
    "motion",
    "lucide-react"
  ],
  "registryDependencies": [],
  "exportName": "HeroBannerAnimated",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added reduced-motion notice",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "headline",
      "type": "string",
      "default": "\"Hyperiux Vault\"",
      "description": "Hero headline text.",
      "suggested": true
    },
    {
      "name": "subheadline",
      "type": "string",
      "default": "\"Animated product story\"",
      "description": "Supporting hero copy.",
      "suggested": true
    },
    {
      "name": "videoSrc",
      "type": "string",
      "default": "\"/showreel.mp4\"",
      "description": "Hero video or texture source.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Accent color for hero highlights.",
      "suggested": true
    },
    {
      "name": "enableZoom",
      "type": "boolean",
      "default": false,
      "description": "Enables the interactive zoom state.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "headline",
        "label": "Headline",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "subheadline",
        "label": "Subheadline",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "videoSrc",
        "label": "Video Src",
        "type": "text",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "enableZoom",
        "label": "Enable Zoom",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/index.jsx"
    },
    {
      "path": "CustomGrainNoise.jsx",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/CustomGrainNoise.jsx"
    },
    {
      "path": "EdgeBlurEffect.jsx",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/EdgeBlurEffect.jsx"
    },
    {
      "path": "RoomModel.jsx",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/RoomModel.jsx"
    },
    {
      "path": "VideoUI.jsx",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/VideoUI.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "type": "registry:component",
      "target": "src/components/effects/hero-banner-animated/createSuspendedRaf.js"
    }
  ]
}
