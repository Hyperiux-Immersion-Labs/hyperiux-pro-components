{
  "name": "zoom-slider",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added title, subheading, and sliderData as public props instead of hardcoding them in the wrapper",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: drag/scroll lerp collapses to direct tracking with no momentum glide, hover text uses a fade instead of a line-slide, and the hover image-scale is skipped",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Zoom Slider",
  "description": "Infinitely looping horizontal image carousel where the active card expands using a quadratic easing curve as it enters from the right. Supports scroll, drag, and touch. Hover reveals GSAP SplitText line animations above each card.",
  "category": "carousels",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/zoom-slider",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "ZoomSlider",
  "exportKind": "default",
  "importPath": "@/components/effects/zoom-slider",
  "target": "src/components/effects/zoom-slider",
  "props": [
    {
      "name": "zoomScale",
      "type": "number",
      "description": "Scale applied to images during slide transitions.",
      "default": 1.2,
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "duration",
      "type": "number",
      "description": "Zoom transition duration.",
      "default": 0.7,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "scaleOnHover",
      "type": "boolean",
      "description": "Enables the image scale-up effect on hover.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "hover",
        "groupTitle": "Hover",
        "groupCollapsible": false
      }
    },
    {
      "name": "textOnHover",
      "type": "boolean",
      "description": "Enables the hover text reveal above each slide.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "hover",
        "groupTitle": "Hover",
        "groupCollapsible": false
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/zoom-slider/index.jsx"
    },
    {
      "path": "ZoomSliderComp.jsx",
      "target": "src/components/effects/zoom-slider/ZoomSliderComp.jsx"
    }
  ]
}
