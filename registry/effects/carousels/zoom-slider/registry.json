{
  "name": "zoom-slider",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added title, subheading, and sliderData as public props instead of hardcoding them in the wrapper",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: drag/scroll lerp collapses to direct tracking with no momentum glide, hover text uses a fade instead of a line-slide, and the hover image-scale is skipped",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Zoom Slider",
  "description": "Infinitely looping horizontal image carousel where the active card expands using a quadratic easing curve as it enters from the right. Supports scroll, drag, and touch. Hover reveals GSAP SplitText line animations above each card.",
  "category": "carousels",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
