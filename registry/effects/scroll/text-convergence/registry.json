{
  "name": "text-convergence",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: per-character fly-in yPercent/rotation range is reduced to 25% strength; the main horizontal scroll is unaffected",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Text Convergence",
  "description": "Horizontal scroll-driven text marquee where characters fly in from random positions and converge into place as you scroll",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/text-convergence",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "TextConvergence",
  "exportKind": "default",
  "importPath": "@/components/effects/text-convergence",
  "target": "src/components/effects/text-convergence",
  "props": [
    { "name": "text", "type": "string", "default": "Build faster. Animate better. Ship smarter. Hyperiux Vault gives you the tools to create high-performance interfaces that look premium and feel effortless.", "description": "Text content that converges on scroll.", "remixer": { "control": "textarea", "group": "content", "groupTitle": "Content" } },
    { "name": "bgColor", "type": "string", "default": "bg-[#111111]", "description": "Background class for the section.", "remixer": { "control": "text", "group": "surface", "groupTitle": "Surface" } },
    { "name": "textColor", "type": "string", "default": "text-[#ffffff]", "description": "Text color class.", "remixer": { "control": "text", "group": "surface", "groupTitle": "Surface" } }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": { "includeOnlyPublicProps": true }
  },
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/text-convergence/index.jsx"
    }
  ]
}
