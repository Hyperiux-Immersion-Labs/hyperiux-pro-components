{
  "name": "svg-pixel-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-28",
      "summary": "Added a reduced-motion notice (ported from the docs copy, which already had it): this effect relies on a continuous scroll-driven pixelated-to-sharp transition and can't be simplified to a fade without losing the effect entirely, so it now surfaces that instead of silently ignoring the preference.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-09",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "SVG Pixel Reveal",
  "description": "Scroll-driven image that transitions from pixelated to crisp using an SVG filter and GSAP ScrollTrigger",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/svg-pixel-reveal",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "SVGPixelReveal",
  "exportKind": "default",
  "importPath": "@/components/effects/svg-pixel-reveal",
  "target": "src/components/effects/svg-pixel-reveal",
  "props": [
    { "name": "intensity", "type": "number", "default": 22, "description": "Starting pixelation intensity before the reveal sharpens the image.", "remixer": { "control": "range", "group": "filter", "groupTitle": "Filter", "min": 2, "max": 80, "step": 1 } },
    { "name": "crossLayers", "type": "boolean", "default": true, "description": "Enables cross-layer pixel merge detail.", "remixer": { "control": "checkbox", "group": "filter", "groupTitle": "Filter" } }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "filter",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": { "includeOnlyPublicProps": true }
  },
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/svg-pixel-reveal/index.jsx"
    },
    {
      "path": "PixelatedSvgFilter.jsx",
      "target": "src/components/effects/svg-pixel-reveal/PixelatedSvgFilter.jsx"
    }
  ]
}
