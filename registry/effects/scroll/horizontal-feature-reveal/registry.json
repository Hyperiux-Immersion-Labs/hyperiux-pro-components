{
  "name": "horizontal-feature-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added prefers-reduced-motion support: SplitText reveal animations and image parallax are skipped while the horizontal scroll remains usable.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Horizontal Feature Reveal",
  "description": "Horizontal storytelling section that converts vertical scroll into a panoramic gallery track",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/horizontal-feature-reveal",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "HorizontalFeatureReveal",
  "exportKind": "default",
  "importPath": "@/components/effects/horizontal-feature-reveal",
  "target": "src/components/effects/horizontal-feature-reveal",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/horizontal-feature-reveal/index.jsx"
    },
    {
      "path": "HorizontalFeatureRevealComp.jsx",
      "target": "src/components/effects/horizontal-feature-reveal/HorizontalFeatureRevealComp.jsx"
    }
  ],
  "props": [
    {
      "name": "features",
      "type": "array",
      "default": [],
      "description": "Feature panels revealed during horizontal scroll.",
      "suggested": true
    },
    {
      "name": "scrollLength",
      "type": "number",
      "default": 2400,
      "description": "Total scroll distance for the reveal.",
      "suggested": true
    },
    {
      "name": "panelGap",
      "type": "number",
      "default": 32,
      "description": "Gap between feature panels.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Color used for active feature highlights.",
      "suggested": true
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links animation progress to scroll position.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "features",
        "label": "Features",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "scrollLength",
        "label": "Scroll Length",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 7200,
        "step": 0.1
      },
      {
        "name": "panelGap",
        "label": "Panel Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 128,
        "step": 1
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "scrub",
        "label": "Scrub",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      }
    ]
  }
}
