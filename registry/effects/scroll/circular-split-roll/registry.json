{
  "name": "circular-split-roll",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-24",
      "summary": "Added prefers-reduced-motion support (ported from the docs copy): notice explaining the continuous scroll-driven rotation cannot be reduced to a static fade.",
      "breaking": false
    },
    {
      "version": "1.0.1",
      "date": "2026-07-17",
      "summary": "Responsiveness fixes",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Circular Split Roll",
  "description": "Split circular slider with orbiting titles on one side and image cards on the other",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/circular-split-roll",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "CircularSplitRoll",
  "exportKind": "default",
  "importPath": "@/components/effects/circular-split-roll",
  "target": "src/components/effects/circular-split-roll",
  "props": [
    {
      "name": "imageCardWidth",
      "type": "number",
      "default": 205,
      "description": "Image card width.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 80,
        "max": 420,
        "step": 1
      }
    },
    {
      "name": "imageCardHeight",
      "type": "number",
      "default": 205,
      "description": "Image card height.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 80,
        "max": 420,
        "step": 1
      }
    },
    {
      "name": "leftRadiusX",
      "type": "number",
      "default": 500,
      "description": "Horizontal radius of the left ring.",
      "remixer": {
        "control": "range",
        "group": "circle",
        "groupTitle": "Circle",
        "min": 100,
        "max": 900,
        "step": 10
      }
    },
    {
      "name": "leftRadiusY",
      "type": "number",
      "default": 500,
      "description": "Vertical radius of the left ring.",
      "remixer": {
        "control": "range",
        "group": "circle",
        "groupTitle": "Circle",
        "min": 100,
        "max": 900,
        "step": 10
      }
    },
    {
      "name": "rightRadiusX",
      "type": "number",
      "default": 500,
      "description": "Horizontal radius of the right ring.",
      "remixer": {
        "control": "range",
        "group": "circle",
        "groupTitle": "Circle",
        "min": 100,
        "max": 900,
        "step": 10
      }
    },
    {
      "name": "rightRadiusY",
      "type": "number",
      "default": 500,
      "description": "Vertical radius of the right ring.",
      "remixer": {
        "control": "range",
        "group": "circle",
        "groupTitle": "Circle",
        "min": 100,
        "max": 900,
        "step": 10
      }
    },
    {
      "name": "textCenterScale",
      "type": "number",
      "default": 1,
      "description": "Title scale near the center of the ring.",
      "remixer": {
        "control": "range",
        "group": "text",
        "groupTitle": "Text",
        "min": 0.4,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "textSideScale",
      "type": "number",
      "default": 0.68,
      "description": "Title scale away from the center.",
      "remixer": {
        "control": "range",
        "group": "text",
        "groupTitle": "Text",
        "min": 0.1,
        "max": 1.5,
        "step": 0.02
      }
    },
    {
      "name": "textSideOpacity",
      "type": "number",
      "default": 0.18,
      "description": "Title opacity away from the center.",
      "remixer": {
        "control": "range",
        "group": "text",
        "groupTitle": "Text",
        "min": 0,
        "max": 1,
        "step": 0.02
      }
    },
    {
      "name": "imageCenterScale",
      "type": "number",
      "default": 1,
      "description": "Image scale near the center of the ring.",
      "remixer": {
        "control": "range",
        "group": "images",
        "groupTitle": "Images",
        "min": 0.4,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "imageSideScale",
      "type": "number",
      "default": 0.58,
      "description": "Image scale away from the center.",
      "remixer": {
        "control": "range",
        "group": "images",
        "groupTitle": "Images",
        "min": 0.1,
        "max": 1.5,
        "step": 0.02
      }
    },
    {
      "name": "imageSideOpacity",
      "type": "number",
      "default": 0.14,
      "description": "Image opacity away from the center.",
      "remixer": {
        "control": "range",
        "group": "images",
        "groupTitle": "Images",
        "min": 0,
        "max": 1,
        "step": 0.02
      }
    },
    {
      "name": "items",
      "type": "array",
      "description": "Content items revealed by the split roll.",
      "default": [],
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "segments",
      "type": "number",
      "description": "Number of circular split segments.",
      "default": 12,
      "remixer": {
        "control": "range",
        "group": "controls",
        "groupTitle": "Controls",
        "min": 0,
        "max": 240,
        "step": 1
      }
    },
    {
      "name": "duration",
      "type": "number",
      "description": "Roll animation duration.",
      "default": 0.8,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "description": "Delay between segment animations.",
      "default": 0.04,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "accentColor",
      "type": "color",
      "description": "Highlight color during the reveal.",
      "default": "#ff6b00",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "layout",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/circular-split-roll/index.jsx"
    },
    {
      "path": "CircularSplitRollComp.jsx",
      "target": "src/components/effects/circular-split-roll/CircularSplitRollComp.jsx"
    }
  ]
}
