{
  "name": "split-canvas",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: the pixel-grid shutter transition becomes a plain crossfade between images",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Split Canvas",
  "description": "Scroll-synced canvas transition that reveals images through sliced pixel-grid shutters",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "three",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/split-canvas",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "SplitCanvas",
  "exportKind": "default",
  "importPath": "@/components/effects/split-canvas",
  "target": "src/components/effects/split-canvas",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/split-canvas/index.jsx"
    },
    {
      "path": "PixelScrollCanvas.jsx",
      "target": "src/components/effects/split-canvas/PixelScrollCanvas.jsx"
    },
    {
      "path": "content.js",
      "target": "src/components/effects/split-canvas/content.js"
    },
    {
      "path": "pixel-transition.js",
      "target": "src/components/effects/split-canvas/pixel-transition.js"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/split-canvas/createSuspendedRaf.js"
    }
  ],
  "props": [
    {
      "name": "split",
      "type": "number",
      "default": 0.5,
      "description": "Initial split position.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Canvas background color.",
      "suggested": true
    },
    {
      "name": "transitionDuration",
      "type": "number",
      "default": 0.6,
      "description": "Split transition duration.",
      "suggested": true
    },
    {
      "name": "leftContent",
      "type": "reactNode",
      "description": "Content rendered on the left canvas side.",
      "default": "defaultLeft",
      "remixer": {
        "control": "range",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "rightContent",
      "type": "reactNode",
      "description": "Content rendered on the right canvas side.",
      "default": "defaultRight",
      "remixer": {
        "control": "range",
        "group": "content",
        "groupTitle": "Content"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "split",
        "label": "Split",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "transitionDuration",
        "label": "Transition Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    ]
  }
}
