{
  "name": "split-canvas",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: the pixel-grid shutter transition becomes a plain crossfade between images",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Split Canvas",
  "description": "Scroll-synced canvas transition that reveals images through sliced pixel-grid shutters",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "three",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/split-canvas",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "SplitCanvas",
  "exportKind": "default",
  "importPath": "@/components/effects/split-canvas",
  "target": "src/components/effects/split-canvas",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/split-canvas/index.jsx"
    },
    {
      "path": "PixelScrollCanvas.jsx",
      "target": "src/components/effects/split-canvas/PixelScrollCanvas.jsx"
    },
    {
      "path": "content.js",
      "target": "src/components/effects/split-canvas/content.js"
    },
    {
      "path": "pixel-transition.js",
      "target": "src/components/effects/split-canvas/pixel-transition.js"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/split-canvas/createSuspendedRaf.js"
    }
  ],
  "props": [
    {
      "name": "bgColor",
      "type": "color",
      "default": "#F5F5F0",
      "description": "Page background color.",
      "remixer": { "control": "color", "group": "style", "groupTitle": "Style" }
    },
    {
      "name": "gridSize",
      "type": "number",
      "default": 16,
      "description": "Pixel-dissolve shader's grid cell size, in px.",
      "remixer": { "control": "range", "group": "shader", "groupTitle": "Shader", "min": 2, "max": 64, "step": 1 }
    },
    {
      "name": "numSlices",
      "type": "number",
      "default": 32,
      "description": "Number of horizontal slices the pixel-wipe transition is split into.",
      "remixer": { "control": "range", "group": "shader", "groupTitle": "Shader", "min": 2, "max": 128, "step": 1 }
    },
    {
      "name": "canvasSize",
      "type": "number",
      "default": 599,
      "description": "Size (px) of the central transitioning canvas panel on desktop — mobile/tablet sizes scale proportionally.",
      "remixer": { "control": "range", "group": "shader", "groupTitle": "Shader", "min": 200, "max": 900, "step": 1 }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "shader",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": { "includeOnlyPublicProps": true }
  }
}
