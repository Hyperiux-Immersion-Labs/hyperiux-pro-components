{
  "name": "rotation-slider",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: perspective is flattened, the main scroll tracking loses its smoothing lag, and card rotation is cut to 15% strength",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Rotation Slider",
  "description": "Scroll-pinned horizontal slider with 3D card rotation, vertical drift, and SplitText caption reveals.",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/rotation-slider",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "RotationSlider",
  "exportKind": "default",
  "importPath": "@/components/effects/rotation-slider",
  "target": "src/components/effects/rotation-slider",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/rotation-slider/index.jsx"
    },
    {
      "path": "RotationSliderComp.jsx",
      "target": "src/components/effects/rotation-slider/RotationSliderComp.jsx"
    }
  ],
  "props": [
    {
      "name": "slides",
      "type": "array",
      "default": [],
      "description": "Slides used by the rotation slider.",
      "suggested": true
    },
    {
      "name": "rotationAmount",
      "type": "number",
      "default": 18,
      "description": "Rotation applied during slide transitions.",
      "suggested": true
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.65,
      "description": "Slide transition duration.",
      "suggested": true
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "default": false,
      "description": "Automatically advances slides.",
      "suggested": true
    },
    {
      "name": "showControls",
      "type": "boolean",
      "default": false,
      "description": "Shows slider navigation controls.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "slides",
        "label": "Slides",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "rotationAmount",
        "label": "Rotation Amount",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 54,
        "step": 0.1
      },
      {
        "name": "duration",
        "label": "Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "autoplay",
        "label": "Autoplay",
        "type": "toggle",
        "group": "motion",
        "copyable": true
      },
      {
        "name": "showControls",
        "label": "Show Controls",
        "type": "toggle",
        "group": "content",
        "copyable": true
      }
    ]
  }
}
