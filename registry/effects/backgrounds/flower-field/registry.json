{
  "name": "flower-field",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-11-02",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Flower Field",
  "description": "A 3D meadow of wood anemones that bloom and sway under the pointer.",
  "category": "backgrounds",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/postprocessing",
    "postprocessing",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/flower-field",
  "tier": "pro",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "FlowerField",
  "exportKind": "default",
  "importPath": "@/components/effects/flower-field",
  "target": "src/components/effects/flower-field",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/flower-field/index.tsx"
    }
  ],
  "props": [
    {
      "name": "follow",
      "label": "Follow",
      "type": "number",
      "default": 1,
      "description": "How strongly the pointer blows the flowers away from it, like a gust of air. 0 leaves them be.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "followRadius",
      "label": "Reach",
      "type": "number",
      "default": 1.3,
      "description": "Reach of the pointer, in world units.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.4,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "bloomOnHover",
      "label": "Bloom on hover",
      "type": "boolean",
      "default": true,
      "description": "Open buds as the pointer passes over them.",
      "remixer": {
        "control": "checkbox",
        "group": "cursor",
        "groupTitle": "Cursor"
      }
    },
    {
      "name": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "description": "How quickly the flowers open, and how springy their stems are.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.3,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "breeze",
      "label": "Breeze",
      "type": "number",
      "default": 1,
      "description": "How much the breeze sways the flowers. 0 holds them still.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "density",
      "label": "Density",
      "type": "number",
      "default": 1,
      "description": "How many flowers and buds grow across the frame. 1 is the reference meadow.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0.4,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "glow",
      "label": "Glow",
      "type": "number",
      "default": 1,
      "description": "Strength of the glow around the flowers.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "depthOfField",
      "label": "Depth of field",
      "type": "number",
      "default": 1,
      "description": "How blurred the flowers in front of and behind the focus are. 0 keeps everything sharp.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "mist",
      "label": "Mist",
      "type": "number",
      "default": 1,
      "description": "Strength of the mist along the ground.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "grain",
      "label": "Grain",
      "type": "number",
      "default": 0.05,
      "description": "Film grain strength. 0 turns it off.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 0.3,
        "step": 0.01
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
