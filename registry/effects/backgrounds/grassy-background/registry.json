{
  "name": "grassy-background",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-11-02",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Grassy Background",
  "description": "Wind-blown grass over slowly shifting rolling hills.",
  "category": "backgrounds",
  "dependencies": [
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/grassy-background",
  "tier": "pro",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "GrassyBackground",
  "exportKind": "default",
  "importPath": "@/components/effects/grassy-background",
  "target": "src/components/effects/grassy-background",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/grassy-background/index.tsx"
    }
  ],
  "props": [
    {
      "name": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "description": "How fast the wind moves through the grass and the hills slowly shift.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 3,
        "step": 0.1,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "wind",
      "label": "Wind",
      "type": "number",
      "default": 0.6,
      "description": "How far the blades lean when gusts roll across the field.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 1.5,
        "step": 0.1,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "hills",
      "label": "Hills",
      "type": "number",
      "default": 1,
      "description": "Height of the rolling hills. 0 gives a flat field.",
      "remixer": {
        "control": "range",
        "group": "shape",
        "groupTitle": "Shape",
        "min": 0,
        "max": 2,
        "step": 0.1
      }
    },
    {
      "name": "terrainScale",
      "label": "Hill size",
      "type": "number",
      "default": 1,
      "description": "How many hills fit on screen. Lower values give wider, softer hills.",
      "remixer": {
        "control": "range",
        "group": "shape",
        "groupTitle": "Shape",
        "min": 0.3,
        "max": 3,
        "step": 0.1
      }
    },
    {
      "name": "horizon",
      "label": "Horizon",
      "type": "number",
      "default": 0.5,
      "description": "Where the field sits on screen. Higher values tilt the view down so the grass fills more of it.",
      "remixer": {
        "control": "range",
        "group": "shape",
        "groupTitle": "Shape",
        "min": 0,
        "max": 1,
        "step": 0.1
      }
    },
    {
      "name": "density",
      "label": "Density",
      "type": "number",
      "default": 1,
      "description": "How many grass blades are drawn. Lower it for slower devices.",
      "remixer": {
        "control": "range",
        "group": "grass",
        "groupTitle": "Grass",
        "min": 0.3,
        "max": 1.5,
        "step": 0.1
      }
    },
    {
      "name": "bladeHeight",
      "label": "Blade height",
      "type": "number",
      "default": 1,
      "description": "How tall each grass blade stands above the ground.",
      "remixer": {
        "control": "range",
        "group": "grass",
        "groupTitle": "Grass",
        "min": 0.2,
        "max": 3,
        "step": 0.1
      }
    },
    {
      "name": "bladeWidth",
      "label": "Blade width",
      "type": "number",
      "default": 1,
      "description": "How thick each grass blade is at the root.",
      "remixer": {
        "control": "range",
        "group": "grass",
        "groupTitle": "Grass",
        "min": 0.5,
        "max": 3,
        "step": 0.1
      }
    },
    {
      "name": "mouseInteractive",
      "label": "Mouse",
      "type": "boolean",
      "default": true,
      "description": "Grass parts around the cursor and gets swept along as it moves.",
      "remixer": {
        "control": "checkbox",
        "group": "interaction",
        "groupTitle": "Interaction",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "mouseStrength",
      "label": "Mouse strength",
      "type": "number",
      "default": 1,
      "description": "How far the grass bends away from the cursor. Needs Mouse on.",
      "remixer": {
        "control": "range",
        "group": "interaction",
        "groupTitle": "Interaction",
        "min": 0,
        "max": 2,
        "step": 0.1,
        "disabledWhen": {
          "prop": "mouseInteractive",
          "equals": false
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "mouseSize",
      "label": "Mouse size",
      "type": "number",
      "default": 1,
      "description": "Size of the patch of grass around the cursor that bends away. Needs Mouse on.",
      "remixer": {
        "control": "range",
        "group": "interaction",
        "groupTitle": "Interaction",
        "min": 0.3,
        "max": 3,
        "step": 0.1,
        "disabledWhen": {
          "prop": "mouseInteractive",
          "equals": false
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "backgroundColor",
      "label": "Background",
      "type": "color",
      "default": "#000000",
      "description": "Colour of the sky and the gaps between blades.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colours"
      }
    },
    {
      "name": "shadowColor",
      "label": "Shadow",
      "type": "color",
      "default": "#16260f",
      "description": "Colour of the grass on slopes facing away from the light.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colours"
      }
    },
    {
      "name": "grassColor",
      "label": "Grass",
      "type": "color",
      "default": "#446f22",
      "description": "Main colour of the grass.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colours"
      }
    },
    {
      "name": "highlightColor",
      "label": "Highlight",
      "type": "color",
      "default": "#b4ec5a",
      "description": "Colour of the brightest grass on slopes facing the light.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colours"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
