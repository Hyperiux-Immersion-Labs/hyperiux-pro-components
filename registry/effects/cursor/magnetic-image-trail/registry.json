{
  "name": "magnetic-image-trail",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "reduce-motion applied",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Magnetic Image Trail",
  "description": "Canvas 2D effect that orbits a cluster of images around the cursor in a diagonal loop. Images scale up in the direction of movement and push forward/upward based on mouse velocity, creating a magnetic pull feel.",
  "category": "cursor",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/magnetic-image-trail",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "MagneticImageTrail",
  "exportKind": "default",
  "importPath": "@/components/effects/magnetic-image-trail",
  "target": "src/components/effects/magnetic-image-trail",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/magnetic-image-trail/index.jsx"
    },
    {
      "path": "MagneticTrail.jsx",
      "target": "src/components/effects/magnetic-image-trail/MagneticTrail.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/magnetic-image-trail/createSuspendedRaf.js"
    }
  ],
  "props": [
    {
      "name": "images",
      "type": "array",
      "default": [],
      "description": "Images emitted in the magnetic trail.",
      "suggested": true
    },
    {
      "name": "trailLength",
      "type": "number",
      "default": 16,
      "description": "Maximum visible images in the trail.",
      "suggested": true
    },
    {
      "name": "magnetStrength",
      "type": "number",
      "default": 0.25,
      "description": "Strength of magnetic pull toward the cursor path.",
      "suggested": true
    },
    {
      "name": "imageSize",
      "type": "number",
      "default": 120,
      "description": "Rendered trail image size.",
      "suggested": true
    },
    {
      "name": "fadeDuration",
      "type": "number",
      "default": 0.8,
      "description": "Time before trail images fade out.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "images",
        "label": "Images",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "trailLength",
        "label": "Trail Length",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 48,
        "step": 0.1
      },
      {
        "name": "magnetStrength",
        "label": "Magnet Strength",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "imageSize",
        "label": "Image Size",
        "type": "range",
        "group": "content",
        "copyable": true,
        "min": 0,
        "max": 480,
        "step": 1
      },
      {
        "name": "fadeDuration",
        "label": "Fade Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    ]
  }
}
