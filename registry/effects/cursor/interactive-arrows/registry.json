  "type": "registry:component",
  "title": "Interactive Arrows",
  "description": "Canvas 2D collection of six cursor-reactive arrow and line effects: a hover-push arrow grid, an opacity-fade variant, a smooth-easing sparse grid, a particle-lines dot field, a persistent lines field, and a playful full-screen grid with center cutout. Scroll-driven background color transitions via GSAP ScrollTrigger.",
  "category": "cursor",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/interactive-arrows",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "InteractiveArrows",
  "exportKind": "default",
  "importPath": "@/components/effects/interactive-arrows",
  "target": "src/components/effects/interactive-arrows",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/interactive-arrows/index.jsx"
    },
    {
      "path": "arrows.jsx",
      "target": "src/components/effects/interactive-arrows/arrows.jsx"
    },
    {
      "path": "ArrowsLimit.jsx",
      "target": "src/components/effects/interactive-arrows/ArrowsLimit.jsx"
    },
    {
      "path": "ArrowsOpacity.jsx",
      "target": "src/components/effects/interactive-arrows/ArrowsOpacity.jsx"
    },
    {
      "path": "ArrowsPlay.jsx",
      "target": "src/components/effects/interactive-arrows/ArrowsPlay.jsx"
    },
    {
      "path": "lines.jsx",
      "target": "src/components/effects/interactive-arrows/lines.jsx"
    },
    {
      "path": "points.jsx",
      "target": "src/components/effects/interactive-arrows/points.jsx"
    },
    {
