{
  "name": "colorful-cursor-aura",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "reduce-motion applied",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Colorful Cursor Aura",
  "description": "Layered radial color aura that follows the cursor across oversized headline text",
  "category": "cursor",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/colorful-cursor-aura",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "ColorfulCursorAura",
  "exportKind": "default",
  "importPath": "@/components/effects/colorful-cursor-aura",
  "target": "src/components/effects/colorful-cursor-aura",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/colorful-cursor-aura/index.jsx"
    },
    {
      "path": "ColorfulCursorAuraComp.jsx",
      "target": "src/components/effects/colorful-cursor-aura/ColorfulCursorAuraComp.jsx"
    }
  ],
  "props": [
    {
      "name": "auraSize",
      "type": "number",
      "default": 160,
      "description": "Diameter of the cursor aura.",
      "suggested": true
    },
    {
      "name": "colors",
      "type": "array",
      "default": [],
      "description": "Gradient colors used in the aura.",
      "suggested": true
    },
    {
      "name": "blur",
      "type": "number",
      "default": 32,
      "description": "Blur amount applied to the aura.",
      "suggested": true
    },
    {
      "name": "opacity",
      "type": "number",
      "default": 0.75,
      "description": "Aura opacity.",
      "suggested": true
    },
    {
      "name": "followSpeed",
      "type": "number",
      "default": 0.12,
      "description": "How quickly the aura follows the cursor.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "auraSize",
        "label": "Aura Size",
        "type": "range",
        "group": "content",
        "copyable": true,
        "min": 0,
        "max": 640,
        "step": 1
      },
      {
        "name": "colors",
        "label": "Colors",
        "type": "color",
        "group": "content",
        "copyable": true
      },
      {
        "name": "blur",
        "label": "Blur",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 96,
        "step": 0.1
      },
      {
        "name": "opacity",
        "label": "Opacity",
        "type": "range",
        "group": "style",
        "copyable": true,
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "name": "followSpeed",
        "label": "Follow Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    ]
  }
}
