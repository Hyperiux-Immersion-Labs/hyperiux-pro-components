{
  "name": "directional-menu",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: mega menu open/close panel animations use a reduced-motion-safe fade instead of the full height/slide tween",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Directional Menu",
  "description": "Mega menu with directional content transitions using GSAP",
  "category": "navigation",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/directional-menu",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "DirectionalMenu",
  "exportKind": "default",
  "importPath": "@/components/effects/directional-menu",
  "target": "src/components/effects/directional-menu",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/directional-menu/index.jsx"
    },
    {
      "path": "DirectionalMegaMenu.jsx",
      "target": "src/components/effects/directional-menu/DirectionalMegaMenu.jsx"
    },
    {
      "path": "Menu1.jsx",
      "target": "src/components/effects/directional-menu/Menu1.jsx"
    },
    {
      "path": "Menu2.jsx",
      "target": "src/components/effects/directional-menu/Menu2.jsx"
    },
    {
      "path": "Menu3.jsx",
      "target": "src/components/effects/directional-menu/Menu3.jsx"
    },
    {
      "path": "MobileDirectionalMenu.jsx",
      "target": "src/components/effects/directional-menu/MobileDirectionalMenu.jsx"
    },
    {
      "path": "useFocusTrap.js",
      "target": "src/components/effects/directional-menu/useFocusTrap.js"
    }
  ],
  "props": [
    {
      "name": "closeDelay",
      "type": "number",
      "default": 80,
      "description": "Delay before closing the menu.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 540,
        "step": 10
      }
    },
    {
      "name": "panelGap",
      "type": "number",
      "default": 20,
      "description": "Gap between trigger and submenu panel.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0,
        "max": 100,
        "step": 1
      }
    },
    {
      "name": "activeColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Color for active menu state.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "inactiveColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Color for inactive menu state.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.35,
      "description": "Menu transition duration.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1.5,
        "step": 0.05
      }
    },
    {
      "name": "ease",
      "type": "string",
      "default": "power2.inOut",
      "description": "GSAP easing used for menu transitions.",
      "remixer": {
        "control": "select",
        "group": "motion",
        "groupTitle": "Motion",
        "options": [
          { "value": "power2.inOut", "label": "Power 2 In Out" },
          { "value": "power3.out", "label": "Power 3 Out" },
          { "value": "power4.inOut", "label": "Power 4 In Out" },
          { "value": "expo.out", "label": "Expo Out" }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
