{
  "name": "directional-menu",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: mega menu open/close panel animations use a reduced-motion-safe fade instead of the full height/slide tween",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Directional Menu",
  "description": "Mega menu with directional content transitions using GSAP",
  "category": "navigation",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/directional-menu",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "DirectionalMenu",
  "exportKind": "default",
  "importPath": "@/components/effects/directional-menu",
  "target": "src/components/effects/directional-menu",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/directional-menu/index.jsx"
    },
    {
      "path": "DirectionalMegaMenu.jsx",
      "target": "src/components/effects/directional-menu/DirectionalMegaMenu.jsx"
    },
    {
      "path": "Menu1.jsx",
      "target": "src/components/effects/directional-menu/Menu1.jsx"
    },
    {
      "path": "Menu2.jsx",
      "target": "src/components/effects/directional-menu/Menu2.jsx"
    },
    {
      "path": "Menu3.jsx",
      "target": "src/components/effects/directional-menu/Menu3.jsx"
    },
    {
      "path": "MobileDirectionalMenu.jsx",
      "target": "src/components/effects/directional-menu/MobileDirectionalMenu.jsx"
    },
    {
      "path": "useFocusTrap.js",
      "target": "src/components/effects/directional-menu/useFocusTrap.js"
    }
  ],
  "props": [
    {
      "name": "items",
      "type": "array",
      "default": [],
      "description": "Menu items and panel content.",
      "suggested": true
    },
    {
      "name": "closeDelay",
      "type": "number",
      "default": 180,
      "description": "Delay before closing the menu.",
      "suggested": true
    },
    {
      "name": "panelGap",
      "type": "number",
      "default": 20,
      "description": "Gap between trigger and submenu panel.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Color for active menu state.",
      "suggested": true
    },
    {
      "name": "openOnHover",
      "type": "boolean",
      "default": false,
      "description": "Opens panels on hover instead of click.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "items",
        "label": "Items",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "closeDelay",
        "label": "Close Delay",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 540,
        "step": 0.1
      },
      {
        "name": "panelGap",
        "label": "Panel Gap",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "openOnHover",
        "label": "Open On Hover",
        "type": "toggle",
        "group": "motion",
        "copyable": true
      }
    ]
  }
}
