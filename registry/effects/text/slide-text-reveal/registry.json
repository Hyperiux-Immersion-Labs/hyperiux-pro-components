{
  "name": "slide-text-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion slide reveal.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Slide Text Reveal",
  "description": "Characters slide in from the right with staggered fade animation on scroll",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/slide-text-reveal",
  "tier": "pro",
  "exportName": "SlideTextReveal",
  "exportKind": "default",
  "main": "index.jsx",
  "props": [
    { "name": "animateOnScroll", "type": "boolean", "default": true, "description": "Runs reveal on scroll.", "remixer": { "control": "checkbox", "group": "behavior", "groupTitle": "Behavior" } },
    { "name": "delay", "type": "number", "default": 0, "description": "Animation delay.", "remixer": { "control": "range", "group": "timing", "groupTitle": "Timing", "min": 0, "max": 2, "step": 0.05 } },
    { "name": "start", "type": "string", "default": "top 80%", "description": "ScrollTrigger start position.", "remixer": { "control": "text", "group": "scroll", "groupTitle": "Scroll" } },
    { "name": "end", "type": "string", "default": "bottom 60%", "description": "ScrollTrigger end position.", "remixer": { "control": "text", "group": "scroll", "groupTitle": "Scroll" } }
  ],
  "remixer": { "enabled": true, "defaultOpenGroupId": "behavior", "layout": { "buttonClassName": "right-4! top-25!", "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!" }, "copyCode": { "includeOnlyPublicProps": true } },
  "files": [
    {
      "path": "index.jsx",
      "type": "registry:component",
      "target": "src/components/effects/slide-text-reveal/index.jsx"
    }
  ]
}
