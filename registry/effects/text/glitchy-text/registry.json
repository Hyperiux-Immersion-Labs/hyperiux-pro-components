{
  "name": "glitchy-text",
  "version": "1.2.0",
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-30",
      "summary": "Removed text and runOnScroll controls. Added working baseTextColor and glitchColor props for the main and yellow glitch layers.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion glitch playback.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Glitchy Text",
  "description": "GSAP SplitText effect that stagger-animates four overlapping char layers — two white and two yellow — out and in at slightly different delays, creating a chromatic glitch swap. Plays on mount and replays on button click.",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/glitchy-text",
  "tier": "pro",
  "exportName": "GlitchyText",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    {
      "name": "initialDelay",
      "type": "number",
      "default": 2.5,
      "description": "Initial animation delay in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "name": "replayDelay",
      "type": "number",
      "default": 0.2,
      "description": "Replay animation delay in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "baseTextColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Base text layer color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "glitchColor",
      "type": "string",
      "default": "#eab308",
      "description": "Accent color for the glitch layers and replay button.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "colors",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/glitchy-text/index.tsx"
    }
  ]
}
