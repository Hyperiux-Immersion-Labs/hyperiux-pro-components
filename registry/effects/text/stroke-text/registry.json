{
  "name": "stroke-text",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-08-14",
      "summary": "Released the effect as free.",
      "breaking": false
    },
    {
      "version": "1.0.2",
      "date": "2026-08-14",
      "summary": "Restored the default fontWeight prop value to 700.",
      "breaking": false
    },
    {
      "version": "1.0.1",
      "date": "2026-08-14",
      "summary": "Switched to a flat background color and made reduced-motion fill apply instantly.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-08-14",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Stroke Text",
  "description": "Outlined text that fills on hover from configurable directions, with optional character-by-character stagger.",
  "category": "text",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/stroke-text",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "StrokeText",
  "exportKind": "default",
  "importPath": "@/components/effects/stroke-text",
  "target": "src/components/effects/stroke-text",
  "props": [
    {
      "name": "variant",
      "type": "string",
      "default": "top",
      "description": "Direction or shape used for the fill reveal.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "topLeft",
            "label": "Top Left"
          },
          {
            "value": "topRight",
            "label": "Top Right"
          },
          {
            "value": "bottomLeft",
            "label": "Bottom Left"
          },
          {
            "value": "bottomRight",
            "label": "Bottom Right"
          },
          {
            "value": "radial",
            "label": "Radial"
          }
        ]
      }
    },
    {
      "name": "characterFill",
      "type": "boolean",
      "default": false,
      "description": "Reveals the fill character by character on hover.",
      "remixer": {
        "control": "checkbox",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "fillColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Color that fills the text on hover.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "strokeColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Outline stroke color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#17191b",
      "description": "Primary background color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "fontSize",
      "type": "number",
      "default": 8,
      "description": "Font size in vw units.",
      "remixer": {
        "control": "range",
        "group": "type",
        "groupTitle": "Type",
        "min": 4,
        "max": 18,
        "step": 0.25
      }
    },
    {
      "name": "fontWeight",
      "type": "number",
      "default": 700,
      "description": "Font weight.",
      "remixer": {
        "control": "range",
        "group": "type",
        "groupTitle": "Type",
        "min": 100,
        "max": 900,
        "step": 100
      }
    },
    {
      "name": "strokeWidth",
      "type": "number",
      "default": 0.01,
      "description": "Stroke width in em units.",
      "remixer": {
        "control": "range",
        "group": "type",
        "groupTitle": "Type",
        "min": 0.01,
        "max": 0.12,
        "step": 0.01
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.5,
      "description": "Hover fill transition duration.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "characterStagger",
      "type": "number",
      "default": 0.045,
      "description": "Delay between each character fill step.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.2,
        "step": 0.005
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/stroke-text/index.tsx"
    }
  ]
}
