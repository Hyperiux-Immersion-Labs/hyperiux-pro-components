  ],
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added items as a public prop with a working remixer panel. The originally suggested previewPlacement/activeIndex/accentColor/duration props don't exist - the preview image position, colors, and timings are fixed in InteractiveListPreviewComp - so they were dropped rather than shipping non-functional controls.",
      "breaking": false
    },
    {
      "version": "1.1.1",
      "date": "2026-07-23",
      "summary": "Renamed helper ListHover.jsx to InteractiveListPreviewComp.jsx (default export) to match the production naming convention and eliminate registry/docs mirror drift.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Under reduced motion, single-image opacity fade and no cursor parallax",
      "breaking": false
    }
  ],
