        }
      ],
      "description": "Stack cards (quote, tag, bg, accent).",
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "cardWidth",
      "type": "number",
      "default": 280,
      "description": "Width of each card in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 160,
        "max": 420,
        "step": 4
      }
    },
    {
      "name": "cardHeight",
      "type": "number",
      "default": 360,
      "description": "Height of each card in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 200,
        "max": 520,
        "step": 4
      }
    },
    {
      "name": "overlap",
      "type": "number",
      "default": 96,
      "description": "Horizontal overlap between resting cards in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0,
        "max": 200,
        "step": 2
      }
    },
    {
      "name": "pushDistance",
      "type": "number",
      "default": 235,
      "description": "Distance neighboring cards are pushed aside on hover.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 100,
        "max": 400,
        "step": 5
      }
    },
    {
      "name": "hoverLift",
      "type": "number",
      "default": 30,
      "description": "Vertical lift applied to the hovered card in pixels.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 0,
        "max": 100,
        "step": 2
      }
    },
    {
      "name": "items",
      "type": "array",
      "description": "Stack items shown on hover.",
      "default": [],
      "remixer": {
        "control": "json",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "spread",
      "type": "number",
      "description": "Distance cards spread while hovered.",
      "default": 24,
      "remixer": {
        "control": "range",
        "group": "controls",
        "groupTitle": "Controls",
        "min": 0,
        "max": 72,
        "step": 1
      }
    },
    {
      "name": "rotation",
      "type": "number",
      "description": "Rotation amount applied to stacked items.",
      "default": 7,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": -180,
        "max": 180,
        "step": 1
      }
    },
    {
      "name": "duration",
      "type": "number",
      "description": "Hover animation duration.",
      "default": 0.35,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "accentColor",
      "type": "color",
      "description": "Highlight color for active stack content.",
      "default": "#ff6b00",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
