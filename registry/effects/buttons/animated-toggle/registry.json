{
  "name": "animated-toggle",
  "version": "1.3.0",
  "changelog": [
    {
      "version": "1.3.0",
      "date": "2026-07-30",
      "summary": "Removed defaultChecked — all three toggles now always start unchecked.",
      "breaking": true
    },
    {
      "version": "1.2.0",
      "date": "2026-07-28",
      "summary": "Added defaultChecked, size, activeColor, inactiveColor, and duration props so the toggles can be restyled without editing source",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: toggle icon transitions respect the user's reduced-motion preference",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Toggle",
  "description": "Pure CSS animated icon components: ChevronBird (chevron/arrow), Cross (plus to X), and Plus (open/close). No animation libraries required.",
  "category": "buttons",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-toggle",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "AnimatedToggle",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-toggle",
  "target": "src/components/effects/animated-toggle",
  "props": [
    {
      "name": "size",
      "type": "number",
      "default": 96,
      "description": "Overall toggle box size in pixels.",
      "remixer": {
        "control": "range",
        "group": "appearance",
        "groupTitle": "Appearance",
        "min": 48,
        "max": 160,
        "step": 4
      }
    },
    {
      "name": "activeColor",
      "type": "color",
      "default": "#ff5f00",
      "description": "Box color when a toggle is active.",
      "remixer": {
        "control": "color",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "inactiveColor",
      "type": "color",
      "default": "#a1a1aa",
      "description": "Box color when a toggle is inactive.",
      "remixer": {
        "control": "color",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.32,
      "description": "Icon transition duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1,
        "step": 0.02
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "appearance",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/animated-toggle/index.jsx"
    },
    {
      "path": "ChevronBird.jsx",
      "target": "src/components/effects/animated-toggle/ChevronBird.jsx"
    },
    {
      "path": "Cross.jsx",
      "target": "src/components/effects/animated-toggle/Cross.jsx"
    },
    {
      "path": "Plus.jsx",
      "target": "src/components/effects/animated-toggle/Plus.jsx"
    }
  ]
}
