{
  "name": "book-flip",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added reduced-motion notice",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Book Flip",
  "description": "3D interactive book viewer with realistic page flips, built with React Three Fiber and Drei.",
  "category": "webgl",
  "dependencies": [
    "three",
    "@react-three/fiber",
    "@react-three/drei",
    "maath"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/book-flip",
  "coverImage": "book-flip",
  "videoUrl": "book-flip.mp4",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "BookFlip",
  "exportKind": "default",
  "importPath": "@/components/effects/book-flip",
  "target": "src/components/effects/book-flip",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/book-flip/index.jsx"
    },
    {
      "path": "Book.jsx",
      "target": "src/components/effects/book-flip/Book.jsx"
    },
    {
      "path": "Experience.jsx",
      "target": "src/components/effects/book-flip/Experience.jsx"
    },
    {
      "path": "PageContext.jsx",
      "target": "src/components/effects/book-flip/PageContext.jsx"
    },
    {
      "path": "UI.jsx",
      "target": "src/components/effects/book-flip/UI.jsx"
    },
    {
      "path": "BookFlip.jsx",
      "target": "src/components/effects/book-flip/BookFlip.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/book-flip/createSuspendedRaf.js"
    }
  ],
  "props": [
    {
      "name": "images",
      "type": "array",
      "default": [],
      "description": "Page images rendered in the book.",
      "suggested": true
    },
    {
      "name": "page",
      "type": "number",
      "default": 0,
      "description": "Initially open page index.",
      "suggested": true
    },
    {
      "name": "pageSpeed",
      "type": "number",
      "default": 0.8,
      "description": "Speed of the page flip animation.",
      "suggested": true
    },
    {
      "name": "bookScale",
      "type": "number",
      "default": 1,
      "description": "Overall scale of the 3D book.",
      "suggested": true
    },
    {
      "name": "showControls",
      "type": "boolean",
      "default": false,
      "description": "Shows page navigation controls.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "images",
        "label": "Images",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "page",
        "label": "Page",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "pageSpeed",
        "label": "Page Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "bookScale",
        "label": "Book Scale",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "showControls",
        "label": "Show Controls",
        "type": "toggle",
        "group": "content",
        "copyable": true
      }
    ]
  }
}
