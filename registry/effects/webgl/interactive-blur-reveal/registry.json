  "category": "webgl",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/interactive-blur-reveal",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "InteractiveBlurReveal",
  "exportKind": "default",
  "importPath": "@/components/effects/interactive-blur-reveal",
  "target": "src/components/effects/interactive-blur-reveal",
  "props": [
    { "name": "iChannel0", "type": "string", "default": "https://picsum.photos/seed/hover7/800/1000", "description": "Primary image texture revealed by pointer movement." },
    { "name": "iChannel1", "type": "string", "default": "https://pub-8abee449136941f5b0a1cd2c014534e9.r2.dev/vault-listing-images/assets-images/interactive-blur-reveal-noise.png", "description": "Noise texture used by the blur reveal shader." }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "media",
    "layout": { "controlsButtonClassName": "right-4! top-25!" },
