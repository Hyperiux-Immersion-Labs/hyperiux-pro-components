{
  "name": "draggable-canvas",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "Added a prefers-reduced-motion notice on the left side, informing users the drag/inertia animation may not honor their reduced-motion preference",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Draggable Canvas",
  "description": "Six independently draggable Canvas 2D windows that each reveal a different cropped region of a shared video, creating a parallax masking illusion. GSAP Draggable with InertiaPlugin gives each window smooth throw physics. Includes a minimal coordinate-display cursor.",
  "category": "webgl",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/draggable-canvas",
  "tier": "pro",
  "main": "index.jsx",
  "exportName": "DraggableCanvas",
  "exportKind": "default",
  "importPath": "@/components/effects/draggable-canvas",
  "target": "src/components/effects/draggable-canvas",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/draggable-canvas/index.jsx"
    },
    {
      "path": "DragCursor.jsx",
      "target": "src/components/effects/draggable-canvas/DragCursor.jsx"
    },
    {
      "path": "MaskedContainer.jsx",
      "target": "src/components/effects/draggable-canvas/MaskedContainer.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/draggable-canvas/createSuspendedRaf.js"
    }
  ],
  "props": [
    {
      "name": "items",
      "type": "array",
      "default": [],
      "description": "Canvas items that can be dragged.",
      "suggested": true
    },
    {
      "name": "dragBounds",
      "type": "string",
      "default": "\"viewport\"",
      "description": "Bounds used for draggable movement.",
      "suggested": true
    },
    {
      "name": "friction",
      "type": "number",
      "default": 0.12,
      "description": "Inertia friction after drag release.",
      "suggested": true
    },
    {
      "name": "scaleOnDrag",
      "type": "number",
      "default": 1.04,
      "description": "Scale applied while dragging.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Canvas background color.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "items",
        "label": "Items",
        "type": "json",
        "group": "content",
        "copyable": true
      },
      {
        "name": "dragBounds",
        "label": "Drag Bounds",
        "type": "select",
        "group": "controls",
        "copyable": true,
        "options": [
          {
            "label": "\"Viewport\"",
            "value": "\"viewport\""
          }
        ]
      },
      {
        "name": "friction",
        "label": "Friction",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "scaleOnDrag",
        "label": "Scale On Drag",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3.12,
        "step": 0.05
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      }
    ]
  }
}
