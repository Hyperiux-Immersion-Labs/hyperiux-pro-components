{
  "name": "milky-way",
  "version": "1.1.0",
  "type": "registry:component",
  "title": "Milky Way",
  "description": "GPU-accelerated GPGPU particle galaxy with spiral arms, curl-noise nebula smoke, twinkling sparkle stars, background starfield, and post-processing vignette + edge blur.",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "@react-three/postprocessing",
    "postprocessing",
    "three",
    "lucide-react",
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/milky-way",
  "tier": "free",
  "subfolder": true,
  "main": "index.jsx",
  "exportName": "MilkyWay",
  "exportKind": "default",
  "importPath": "@/components/effects/milky-way",
  "target": "src/components/effects/milky-way",
  "files": [
    {
      "path": "index.jsx",
      "target": "src/components/effects/milky-way/index.jsx"
    },
    {
      "path": "circular-text.jsx",
      "target": "src/components/effects/milky-way/circular-text.jsx"
    },
    {
      "path": "edge-blur-effect.jsx",
      "target": "src/components/effects/milky-way/edge-blur-effect.jsx"
    },
    {
      "path": "createSuspendedRaf.js",
      "target": "src/components/effects/milky-way/createSuspendedRaf.js"
    }
  ],
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "starCount",
      "type": "number",
      "default": 1800,
      "description": "Number of stars in the scene.",
      "suggested": true
    },
    {
      "name": "galaxyRadius",
      "type": "number",
      "default": 6,
      "description": "Radius of the galaxy spread.",
      "suggested": true
    },
    {
      "name": "rotationSpeed",
      "type": "number",
      "default": 0.2,
      "description": "Galaxy rotation speed.",
      "suggested": true
    },
    {
      "name": "starColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Primary star color.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Canvas background color.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "starCount",
        "label": "Star Count",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 5400,
        "step": 0.1
      },
      {
        "name": "galaxyRadius",
        "label": "Galaxy Radius",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "name": "rotationSpeed",
        "label": "Rotation Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "starColor",
        "label": "Star Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      }
    ]
  }
}
